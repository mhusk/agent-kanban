{
  "name": "@agent-kanban/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@agent-kanban/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^4.22.3",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "jose": "^6.2.18",
    "zod": "^3.25.76"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.config.mjs",
    "test": "vitest run src/__tests__",
    "test:rules": "vitest run tests/rules.test.ts",
    "test:smoke": "vitest run tests/health.test.ts",
    "test:auth": "vitest run tests/auth.test.ts",
    "test:agent-auth": "vitest run tests/agent-auth.test.ts",
    "test:cards": "vitest run tests/cards.test.ts",
    "test:checklists-search": "vitest run tests/checklists-search.test.ts",
    "test:comments-recurrence": "vitest run tests/comments-recurrence.test.ts",
    "test:prioritization": "vitest run tests/prioritization.test.ts",
    "test:bulk": "vitest run tests/bulk-safety.test.ts",
    "test:mcp": "vitest run tests/mcp.test.ts",
    "test:tags": "vitest run tests/tags.test.ts",
    "test:events": "vitest run tests/events.test.ts",
    "test:webhooks": "vitest run tests/webhooks.test.ts",
    "test:jobs": "vitest run tests/jobs.test.ts",
    "test:schedule": "vitest run tests/schedule-nudges.test.ts",
    "test:attachments": "vitest run tests/attachments.test.ts",
    "test:integration": "vitest run tests/ --exclude tests/rules.test.ts --no-file-parallelism"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/express": "^4.17.25",
    "esbuild": "^0.25.12",
    "firebase": "^13.4.0"
  }
}
