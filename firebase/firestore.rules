rules_version = '2';

// API-only data access: all human UI and agent reads/writes go strictly
// through the Cloud Functions API (apps/api) via the Firebase Admin SDK.
// Direct client SDK access to Firestore is intentionally denied on all paths.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
