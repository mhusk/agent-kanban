# =============================================================================
# agent-kanban — Environment Variables Template
# Copy to .env.local (gitignored) for local development. Never commit real values.
# =============================================================================

# Auth mode: "workos" in production, "emulator" strictly in local Firebase Emulators / tests
AUTH_MODE=emulator

# Household IANA timezone (DST-aware, e.g., UTC, America/New_York, Europe/London)
HOUSEHOLD_TIMEZONE=UTC

# WorkOS AuthKit configuration (required when AUTH_MODE=workos)
# Note: In multi-application WorkOS environments, WORKOS_CLIENT_ID / VITE_WORKOS_CLIENT_ID
# uses the app's Client ID, while WORKOS_JWKS_URL and WORKOS_ISSUER use the environment's
# Default application Client ID (matching the JWT `iss` claim). Ensure the WorkOS JWT
# template includes `email` and `email_verified` (see docs/DEPLOYMENT_SETUP.md).
WORKOS_CLIENT_ID=client_example_placeholder
WORKOS_JWKS_URL=https://api.workos.com/sso/jwks/client_example_placeholder
WORKOS_ISSUER=https://api.workos.com/user_management/client_example_placeholder

# Master 32-byte base64 key used to AES-256-GCM envelope-encrypt webhook secrets
# Generate with: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# Number of days before completed non-recurring cards are auto-archived
AUTO_ARCHIVE_DAYS=30

# Cloud Storage bucket URI for daily Firestore export backups (e.g., gs://example-backup-bucket)
BACKUP_BUCKET=gs://example-agent-kanban-backups

# Frontend Vite variables (apps/web)
VITE_AUTH_MODE=emulator
VITE_WORKOS_CLIENT_ID=client_example_placeholder
